    "a2780cis_is_a_data_gap": false,
    "a2780cis_labelled_rows_in_cohort": 600,
    "explanation": "A2780cis is not short of measurements: 600 of the cohort's 4,370 labelled rows are A2780cis. It is short of measurements in the test fold. Re-ordering the same compounds moves its test coverage from 27 to a median of 60 (p05 50, max 77), and dealing the same scaffold groups without regard to size gives a mean of 121.3. So most of the shortfall is the stable-sort tie order, which the cohort file decides because it is written sorted by descending cell-line coverage; the rest is that A2780cis evidence sits on large scaffolds, which largest-first sends to train.",
    "secondary_finding": "The same tie order decides how many cell lines a test compound carries. As written, val is 100% single-cell compounds and test is 82.9% single-cell, while all 56 four-cell compounds sit in train. That is not a per-cell coverage problem; it is the evaluation set being the least multi-task subset of the cohort.",
    "split_fractions_are_group_fractions": {
      "declared": [
        0.7,
        0.1,
        0.2
      ],
      "achieved_by_rows": {
        "train": 0.8393,
        "val": 0.0534,
        "test": 0.1073
      },
      "note": "`_assign_groups` budgets capacities in scaffolds, not rows, so 70/10/20 scaffolds is 84/5/11 rows on this cohort: val receives 105 singleton scaffolds and therefore 105 rows."
    },
    "not_a_fix": "Lowering MIN_EVAL_ROWS would make A2780cis report a number from 27 rows; the split would still have 27. The bar is not what starved the cell.",
    "applied": {
      "mode": "scaffold_coverage",
      "config": "configs/train_cisplatin_resistance_real_strat_v1.yaml",
      "metric": "metrics/by_metric/platinai_3cell_resistance_real_strat.json",
      "what_changed": "`ScaffoldSplitter(coverage={...})` targets fractions of each cell line's labelled rows instead of fractions of the scaffold count, and breaks size ties on a hash of the scaffold. One scaffold still lands in exactly one split, and the split no longer depends on the cohort file's row order.",
      "split": {
        "train": {
          "rows": 1376,
          "labelled": {
            "A549": 663,
            "A2780": 517,
            "A2780cis": 343,
            "MCF-7": 599
