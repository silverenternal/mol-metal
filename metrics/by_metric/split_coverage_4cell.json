          "labelled": {
            "A549": 122,
            "A2780": 219,
            "A2780cis": 171,
            "MCF-7": 160
          }
        }
      },
      "a2780cis_test_rows": 171,
      "all_cells_evaluable": true
    },
    "not_applied": {
      "hash_tiebreak_globally": "Deterministic tie-break on a hash of the scaffold instead of first appearance. Same groups, same fractions, same greedy, no leakage. Over 200 salts A2780cis test coverage never falls below 43 (median 61). Not taken: it changes the split for EVERY ScaffoldSplitter caller, so every number measured on a largest-first scaffold split would have to be re-run or pinned.",
      "reorder_only": "Shuffle the cohort file's row order. Removes the correlation between descending label coverage and train membership, but gives no guarantee: A2780cis ranges 45-77 over permutations."
    }
