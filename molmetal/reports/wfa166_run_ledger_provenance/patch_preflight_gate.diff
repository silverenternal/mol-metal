+def gate_p3_run_ledger_git_provenance(
+    name: str,
+    priority: str,
+    pipeline: str,
+    *,
+    ledger_path: Optional[Path] = None,
+    repo_root: Optional[Path] = None,
+) -> GateResult:
+    """Wf-A166 — run-ledger GIT-provenance gate: does every ledger row name a
+    real, reachable commit that touched the file the row points at?
+
+    WHY THIS GATE EXISTS
+    ---------------------
+    ``molmetal/scripts/run_ledger.py::uncommitted_provenance`` (wired in as
+    ``p3_run_ledger_provenance``) checks ONE axis: does the row's
+    ``source_json_sha256`` match the file on disk or any committed version of
+    it.  It does NOT look at the row's ``git_sha`` at all.  So a row can name
+    a commit that does not exist, a commit that was rewritten away, or a
+    commit unrelated to the file the row points at — and the pre-flight stays
+    green.  This gate closes that hole.
+
+    THE RULE (strict)
+    ------------------
+    FAIL on a metric whose LATEST ledger row has a ``git_sha`` that
+      (i)   does not resolve to a git commit,
+      (ii)  is unreachable from every branch and tag, or
+      (iii) never touched that row's ``source_json``.
+
+    Scoped to the LATEST row per metric — the ledger is append-only
+    (AGENTS.md §5.6), so an EARLIER row with the same defect is HISTORY, it
+    can never be repaired, and it must not be punished for being history.
+
+    MEASURED 2026-11-01 on this working tree (denominator: 418 ledger rows,
+    396 distinct metrics, 396 latest rows):
+
+      * ``commit_exists``       396/396 latest rows name a real commit.
+      * ``commit_reachable``    395 reachable / 1 UNREACHABLE
+        (``chembl29_metal_scan``, git_sha
+        975414bc6fb8ef20ca53429f287a4d3297184cad — a rewritten-away commit
+        that survives only in the reflog).
+      * ``commit_touches_source`` 0/396 touched / 396 NOT touched.
+      * ``sha_vs_committed``    396/396 latest rows match a committed
+        version — cross-checked against
+        ``run_ledger.uncommitted_provenance`` (AGREE on every shared count:
+        418 rows / 396 metrics / 416 pairs / 398 paths / 0 open / 9
+        superseded).
+
+    ⚠️ THIS GATE, WITH THE STRICT RULE, FAILS ON 396 OF 396 METRICS TODAY.
+    Enabling it as-is turns the pre-flight from PASS to FAIL and blocks
+    EVERY launch until the ledger is repaired.  The reason is a SEMANTIC
+    mismatch, not slack in the rule: ``run_ledger.record_run`` sets
+    ``git_sha = git rev-parse HEAD``, so ``git_sha`` means "the repository
+    state when the row was recorded", NOT "the commit that authored the
+    source_json".  A row recorded after an unrelated commit satisfies the
+    real provenance claim and still fails (iii).
+
+    The provenance-TRUE form of (iii) is "the sha256 of ``source_json`` AT
+    ``git_sha`` equals the row's ``source_json_sha256``".  MEASURED on the
+    same tree: 388/396 latest rows MATCH, 7 differ, 1 absent — i.e. 8
+    metrics are open, not 396.  See
+    ``molmetal/reports/wfa166_run_ledger_provenance/`` for the advisory
+    variant that uses that form.
+
+    Implementation: ``molmetal/scripts/wfa166_run_ledger_provenance.py``
+    (``audit_ledger``).  READ-ONLY, CPU-only, torch-free.
+    """
+    t0 = time.perf_counter()
+    try:
+        from molmetal.scripts.wfa166_run_ledger_provenance import audit_ledger
+
+        kwargs: Dict[str, Any] = {}
+        if ledger_path is not None:
+            kwargs["ledger_path"] = ledger_path
+        if repo_root is not None:
+            kwargs["repo_root"] = repo_root
+        rep = audit_ledger(**kwargs)
+    except Exception as exc:  # noqa: BLE001 — a broken ledger is a FAIL
+        return GateResult(
+            name, priority, pipeline, "FAIL",
+            f"{name}: run-ledger git-provenance audit raised "
+            f"{type(exc).__name__}: {exc}",
+            time.perf_counter() - t0,
+        )
+    c = rep["counts"]
+    gv = rep.get("gate_verdict") or {}
+    open_metrics = [str(m) for m in (gv.get("strict_open_metrics") or [])]
+    parts = [
+        f"ledger_rows={c.get('ledger_rows')}",
+        f"metrics={c.get('distinct_metrics')}",
+        f"latest_rows={c.get('latest_rows')}",
+        f"OPEN_metrics={len(open_metrics)}",
+    ]
+    for mid in open_metrics[:25]:
+        parts.append(f"OPEN {mid}")
+    if len(open_metrics) > 25:
+        parts.append(f"... and {len(open_metrics) - 25} more")
+    status = "FAIL" if open_metrics else "PASS"
     return GateResult(
         name, priority, pipeline, status, f"{name}: " + " ".join(parts),
         time.perf_counter() - t0,
