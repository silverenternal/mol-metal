+    # ---- Wf-A170 (2026-11-01) — ADVISORY census-freshness check. ----
+    #
+    # This is ADVISORY BY CONSTRUCTION, on four independent counts:
+    #   * it is NOT registered in build_gates(), so EXPECTED_GATE_COUNTS is
+    #     UNCHANGED (129 on "all", 131 on "launch") — no PINNED gate count
+    #     moves, and no other test's count assertion can break;
+    #   * it NEVER changes the exit code — a stale pin is a finding to
+    #     REPORT, not a reason to block a launch;
+    #   * it is wrapped in try/except, so a missing or broken guard can
+    #     never break a pre-flight run;
+    #   * it is a separate STATUS, not a FAIL — the same posture the WARN
+    #     gates already take (Wf-A125 G11a).
+    #
+    # COST: the guard re-hashes every sha-pinned artefact under
+    # molmetal/reports/.  MEASURED 2026-11-01 on this host: ~15 s against a
+    # ~411 s full pre-flight.
+    census_freshness: Dict[str, Any] = {"status": "SKIP", "reason": "not run"}
