+# Wf-A170 (2026-11-01) — the ADVISORY census-freshness check.
+#
+# WHY THIS IMPORT EXISTS
+# ----------------------
+# A *census artefact* is a JSON file that records the SHA-256 of a file it
+# described.  When the described file is still under active edit, the
+# artefact goes stale on every unrelated edit — and it goes stale SILENTLY:
+# the artefact still says PASS and still carries a verdict derived from a
+# version of the source that no longer exists.  That is the Wf-A159 shape
+# (``molmetal/reports/wfa159_timeout_verdict_census/
+# timeout_verdict_census.json`` pinned a ``target_sha256`` that matched
+# neither HEAD nor the working tree), and the same shape as the §6.262 /
+# §6.264 incidents.
+#
+# The guard is imported (NOT shelled out) for the same reason
+# ``wf343c1_pre_retrain_check`` is: the check is cheap, in-process, and
+# must not spawn anything.  It is STANDARD LIBRARY ONLY — no torch, no
+# CUDA, no subprocess (the git HEAD is read from ``.git`` as files).
+from molmetal.scripts import (  # noqa: E402
+    wfa170_census_freshness_guard as _wfa170_freshness,
+)
