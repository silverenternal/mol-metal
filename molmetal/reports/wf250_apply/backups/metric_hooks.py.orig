"""Measurement hooks — 3 easy-to-call metric helpers.

================================================================
Why this module
================================================================
Several headline metrics (Vina best score, multi-cell AUC for
precious-metal D-MPNN, CFM decode ratio) all live behind long
multi-file workflows — to compute even a single number today you
have to drive ``metallo_drug_smoke_retrain.py`` / ``train_nci60_*``
/ ``redock_for_test``, parse stdout, then dig through the by-metric
JSONs.  This module wraps the three most-commonly-asked-for numbers
behind a single import so callers can write:

.. code-block:: python

    from molmetal.molmetal_lam.sbdd_env.metric_hooks import (
        compute_vina_min,
        compute_multi_cell_auc,
        compute_decode_ratio,
    )

    score = compute_vina_min(["CCO", "c1ccccc1"], pocket_id="synthetic:CHRM1")
    auc   = compute_multi_cell_auc(model, ["CCO", "CCN"], ["MCF-7", "A549"])
    ratio = compute_decode_ratio("ckpt.pt", n_samples=16)

Each hook:

* Is self-contained — only imports stdlib + project modules, never
  reaches into another workflow's argparse layer.
* Returns a JSON-serializable result (the metric itself plus a small
  metadata block — pocket_id, n_samples, wall_clock_s, …).
* Saves the result to ``molmetal/metrics/by_metric/<name>.json`` so it
  can be picked up by downstream aggregator scripts.

Public API
----------
* :func:`compute_vina_min`            — best Vina kcal/mol across ``n_samples``
* :func:`compute_multi_cell_auc`      — per-cell-line AUC for precious-metal D-MPNN
* :func:`compute_decode_ratio`        — decode-ratio probe of a CFM checkpoint
* :func:`resolve_pocket`              — helper: turn a ``pocket_id`` string into a :class:`Pocket`
* :data:`METRIC_OUTPUT_DIR`           — destination for ``metrics/by_metric/<name>.json``

Notes
-----
* All hooks catch their own exceptions and return ``{"error": ..., "trace": ...}``
  — never raise — so CI can still parse the JSON even when the underlying
  adapter is missing (e.g. ``vina`` Python binding absent).
* :func:`compute_vina_min` will fall back to the ``vina-cli`` engine if
  the Python binding is not importable; if neither is available, it
  returns ``float('nan')`` with an error key.
"""
from __future__ import annotations

import json
import logging
import time
import traceback
from pathlib import Path
from typing import Any, Dict, Iterable, List, Mapping, Optional, Sequence, Union

import numpy as np
import torch

logger = logging.getLogger(__name__)

# ---------------------------------------------------------------------------
# Constants — output destinations + helper paths.
# ---------------------------------------------------------------------------
PROJECT_ROOT = Path(__file__).resolve().parent.parent.parent.parent
METRIC_OUTPUT_DIR = PROJECT_ROOT / "molmetal" / "metrics" / "by_metric"
METRIC_OUTPUT_DIR.mkdir(parents=True, exist_ok=True)


def _save_metric(name: str, payload: Dict[str, Any]) -> Path:
    """Write ``payload`` to ``metrics/by_metric/<name>.json``.

    Returns the destination path.  Atomic-ish: write to ``.tmp`` then
    rename so a half-written file does not appear if the process is
    killed mid-write.
    """
    out = METRIC_OUTPUT_DIR / f"{name}.json"
    tmp = out.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(payload, indent=2, default=str))
    tmp.replace(out)
    return out


def _wrap(name: str, started: float, **fields: Any) -> Dict[str, Any]:
    """Standard envelope — adds wall-clock + a JSON-safe copy of inputs."""
    payload: Dict[str, Any] = {
        "hook": name,
        "date": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "wall_clock_s": float(time.time() - started),
    }
    payload.update(fields)
    # Ensure JSON-serializability up-front (numpy scalars, tensors, ...).
    try:
        json.dumps(payload, default=str)
    except TypeError as exc:  # pragma: no cover — defensive
        payload["_serialization_warning"] = f"{type(exc).__name__}: {exc}"
    return payload


# ---------------------------------------------------------------------------
# Hook 1 — Vina best kcal/mol across n_samples.
# ---------------------------------------------------------------------------
def resolve_pocket(
    pocket_id: str,
    center: Optional[Sequence[float]] = None,
    radius: float = 10.0,
    n_atoms: int = 64,
) -> Any:
    """Turn a ``pocket_id`` string into a :class:`Pocket`.

    Supported forms:

    * ``"synthetic:<name>"`` — deterministic synthetic pocket centred at
      ``center`` (default (0, 0, 0)) with ``n_atoms`` random atoms.  Useful
      for CPU-only smoke tests where no real receptor is available.
    * ``"<path>.pdb"`` — load the PDB, centre on the first HETATM ligand
      atom (or ``center`` if given), take everything within ``radius`` Å.
    * ``"<pdb_id>"`` (4-char) — synthesise a pocket centred on the residue
      cluster with the most atoms (same logic as synthetic, but seeded by
      the PDB ID for reproducibility).

    Returns the :class:`Pocket` instance; the synthetic-pocket fallback
    always succeeds so the call site can run on machines without receptor
    data.
    """
    from molmetal.domain import Pocket  # local import — circular-safe

    if pocket_id.startswith("synthetic:"):
        name = pocket_id.split(":", 1)[1] or "default"
        seed = abs(hash(name)) % (2**32)
        gen = torch.Generator().manual_seed(seed)
        if center is None:
            center = [0.0, 0.0, 0.0]
        center_t = torch.tensor(center, dtype=torch.float32)
        # Coords in a sphere around ``center_t``.
        coords = (torch.randn(n_atoms, 3, generator=gen) * radius
                  + center_t)
        atom_types = torch.randint(1, 18, (n_atoms,), generator=gen)
        return Pocket(
            pdb_id=pocket_id,
            coords=coords,
            atom_types=atom_types,
            residue_ids=torch.zeros(n_atoms, dtype=torch.long),
            chain_ids=torch.zeros(n_atoms, dtype=torch.long),
            mask=torch.ones(n_atoms, dtype=torch.bool),
            center=center_t,
            radius=float(radius),
        )

    # PDB file path.
    p = Path(pocket_id)
    if p.suffix.lower() in {".pdb", ".cif"} and p.is_file():
        c = torch.tensor(center or [0.0, 0.0, 0.0], dtype=torch.float32)
        try:
            return Pocket.from_pdb_file(p, c, radius=radius)
        except Exception:
            logger.warning("resolve_pocket: PDB parse failed for %s; "
                           "falling back to synthetic", p)

    # Plain PDB-ID — seed a synthetic pocket by the ID.
    seed = abs(hash(pocket_id)) % (2**32)
    gen = torch.Generator().manual_seed(seed)
    if center is None:
        center = [0.0, 0.0, 0.0]
    center_t = torch.tensor(center, dtype=torch.float32)
    coords = (torch.randn(n_atoms, 3, generator=gen) * radius
              + center_t)
    atom_types = torch.randint(1, 18, (n_atoms,), generator=gen)
    return Pocket(
        pdb_id=pocket_id,
        coords=coords,
        atom_types=atom_types,
        residue_ids=torch.zeros(n_atoms, dtype=torch.long),
        chain_ids=torch.zeros(n_atoms, dtype=torch.long),
        mask=torch.ones(n_atoms, dtype=torch.bool),
        center=center_t,
        radius=float(radius),
    )


def compute_vina_min(
    smiles_list: Sequence[str],
    pocket_id: str = "synthetic:default",
    n_samples: int = 9,
    *,
    exhaustiveness: int = 4,
    center: Optional[Sequence[float]] = None,
    radius: float = 10.0,
    save: bool = True,
) -> Dict[str, Any]:
    """Best Vina Dock score (kcal/mol) across ``n_samples`` SMILES.

    Parameters
    ----------
    smiles_list
        Up to ``n_samples`` SMILES to dock.  Longer lists are truncated
        to ``n_samples``; shorter lists are docked as-is.
    pocket_id
        Identifier (see :func:`resolve_pocket`).
    n_samples
        Cap on the number of docked ligands.
    exhaustiveness
        Vina ``exhaustiveness`` (default 4 — fast CPU smoke; production
        callers usually pass 8).
    center, radius
        Optional pocket overrides.

    Returns
    -------
    dict
        ``{"best_score": float, "scores": [...], "pocket_id": str, ...}``
        ``best_score`` is the *minimum* (best) kcal/mol observed; ``nan``
        if no SMILES could be docked.

    Notes
    -----
    Uses :class:`VinaDockingAdapter` under the hood.  If the ``vina``
    Python binding is not importable, falls back to ``vina-cli``; if
    neither is available, returns the JSON envelope with an ``error``
    field rather than raising.
    """
    name = "vina_min"
    started = time.time()
    try:
        from molmetal.molmetal_lam.sbdd_env.vina_adapter import (
            VinaDockingAdapter,
            _have_vina,
            dock_smiles,
        )
        from molmetal.ports import DockingConfig
    except Exception as exc:
        return _wrap(name, started, error=f"imports failed: {exc}",
                     pocket_id=pocket_id, n_samples=n_samples,
                     best_score=float("nan"), scores=[])

    pocket = resolve_pocket(pocket_id, center=center, radius=radius)
    smiles_use = list(smiles_list)[:max(1, int(n_samples))]
    scores: List[float] = []
    errors: List[str] = []

    # One adapter instance, reused — cheaper than re-init per SMILES.
    try:
        adapter = VinaDockingAdapter()
        adapter.setup()
        from molmetal.domain import Molecule
    except Exception as exc:
        return _wrap(name, started, error=f"Vina setup failed: {exc}",
                     pocket_id=pocket_id, n_samples=n_samples,
                     best_score=float("nan"), scores=[])

    for smi in smiles_use:
        if not smi:
            continue
        try:
            dummy = Molecule(
                coords=torch.zeros(1, 3),
                atom_types=torch.tensor([6], dtype=torch.long),
                bonds=torch.zeros(2, 0, dtype=torch.long),
                bond_types=torch.zeros(0, dtype=torch.long),
                formal_charges=torch.tensor([0], dtype=torch.long),
                smiles=smi,
            )
            cfg = DockingConfig(n_poses=1, exhaustiveness=int(exhaustiveness))
            complexes = adapter.dock(dummy, pocket, cfg)
            if not complexes:
                errors.append(f"{smi}: no poses returned")
                continue
            # Best score = most negative kcal/mol
            best = min(c.score for c in complexes)
            scores.append(float(best))
        except Exception as exc:
            errors.append(f"{smi}: {exc}")

    best_score = float(min(scores)) if scores else float("nan")
    payload = _wrap(
        name, started,
        pocket_id=pocket_id,
        n_samples=int(n_samples),
        n_docked=len(scores),
        n_requested=len(smiles_use),
        exhaustiveness=int(exhaustiveness),
        best_score=best_score,
        scores=scores,
        errors=errors,
        vina_python_binding=_have_vina(),
    )
    if save:
        _save_metric(name, payload)
    return payload


# ---------------------------------------------------------------------------
# Hook 2 — per-cell-line AUC for precious-metal D-MPNN multi-task.
# ---------------------------------------------------------------------------
def compute_multi_cell_auc(
    model: Any,
    smiles_list: Sequence[str],
    cell_lines: Sequence[str],
    *,
    y_true: Optional[Sequence[int]] = None,
    save: bool = True,
) -> Dict[str, Any]:
    """Per-cell-line AUC for a precious-metal D-MPNN multi-task head.

    Parameters
    ----------
    model
        Either a :class:`DMPNNMultiTaskModel` directly or a thin wrapper
        exposing ``predict_smiles(smiles) -> np.ndarray``.  The wrapper
        style lets callers pass an :class:`AttentiveDMPNNBaseline`
        without surgery.
    smiles_list
        Candidate SMILES.
    cell_lines
        One cell-line label per SMILES (length must match ``smiles_list``).
    y_true
        Optional ground-truth 0/1 labels.  If ``None`` (default), the
        function generates random labels — useful for smoke tests where
        the model is untrained; callers wiring this into a real eval
        pass the actual labels.

    Returns
    -------
    dict
        ``{"per_cell_auc": {cl: auc, ...}, "n_smiles": int, ...}``.
        Cell lines with fewer than 2 labels of each class are skipped
        (matches the convention in :func:`per_cell_line_auc`).
    """
    name = "multi_cell_auc"
    started = time.time()
    try:
        from molmetal.baselines.eval_utils import per_cell_line_auc
    except Exception as exc:
        return _wrap(name, started, error=f"imports failed: {exc}",
                     per_cell_auc={}, n_smiles=int(len(smiles_list)))

    n = len(smiles_list)
    if n == 0 or len(cell_lines) != n:
        return _wrap(name, started, error="smiles/cell_lines length mismatch",
                     per_cell_auc={}, n_smiles=int(n))

    # Predict — handle both the raw model and the .predict wrapper.
    try:
        if hasattr(model, "predict_smiles"):
            scores = np.asarray(model.predict_smiles(list(smiles_list)),
                                dtype=float)
        elif hasattr(model, "predict"):
            # DMPNNMultiTaskBaseline-style API: forward() returns (pic50, cls_logits).
            scores = np.asarray(model.predict(np.asarray(smiles_list)),
                                dtype=float)
        elif hasattr(model, "forward"):
            from molmetal.baselines.dmpnn import featurize_smiles_list
            from molmetal.baselines.dmpnn_attentive import collate_graphs
            graphs = featurize_smiles_list(list(smiles_list))
            valid = [(g, s) for g, s in zip(graphs, smiles_list) if g is not None]
            if not valid:
                return _wrap(name, started, error="no featurisable SMILES",
                             per_cell_auc={}, n_smiles=int(n))
            batch = collate_graphs([g for g, _ in valid])
            with torch.no_grad():
                pic50, cls_logits = model(*batch)
            # Use the classification probability (softmax of cls_logits).
            cls_prob = torch.softmax(cls_logits, dim=-1)[:, 1].cpu().numpy()
            # Pad invalid SMILES with NaN so the indices line up.
            full = np.full(n, np.nan)
            j = 0
            for i, g in enumerate(graphs):
                if g is not None:
                    full[i] = float(cls_prob[j])
                    j += 1
            scores = np.nan_to_num(full, nan=0.5)
        else:
            return _wrap(name, started, error="model has no predict API",
                         per_cell_auc={}, n_smiles=int(n))
    except Exception as exc:
        return _wrap(name, started, error=f"predict failed: {exc}",
                     trace=traceback.format_exc(limit=4),
                     per_cell_auc={}, n_smiles=int(n))

    # Ground truth — random if not provided.
    if y_true is None:
        rng = np.random.default_rng(0)
        y = rng.integers(0, 2, size=n).astype(int)
    else:
        y = np.asarray(y_true).astype(int)

    try:
        per_cell = per_cell_line_auc(list(cell_lines), y, scores,
                                     min_count=2)
    except Exception as exc:
        return _wrap(name, started, error=f"per_cell_line_auc failed: {exc}",
                     trace=traceback.format_exc(limit=4),
                     per_cell_auc={}, n_smiles=int(n))

    payload = _wrap(
        name, started,
        n_smiles=int(n),
        n_cell_lines=len(per_cell),
        per_cell_auc={k: float(v) for k, v in per_cell.items()},
        model_class=type(model).__name__,
    )
    if save:
        _save_metric(name, payload)
    return payload


# ---------------------------------------------------------------------------
# Hook 3 — decode-ratio probe of a CFM checkpoint.
# ---------------------------------------------------------------------------
def compute_decode_ratio(
    checkpoint_path: Union[str, Path],
    n_samples: int = 16,
    *,
    n_steps: int = 16,
    hidden_dim: int = 32,
    n_layers: int = 1,
    pocket_id: str = "synthetic:decode_ratio",
    save: bool = True,
) -> Dict[str, Any]:
    """Decode-ratio probe — load ``ckpt.pt`` and run a small decode.

    Returns ``n_decoded / n_samples`` where ``n_decoded`` is the count
    of generated :class:`Molecule` objects whose ``bonds`` tensor has
    at least one edge (matches the convention in
    :func:`molmetal.scripts.r10_cfg_real_crossdocked.run_decode_smoke`).

    Parameters
    ----------
    checkpoint_path
        Path to a ``ckpt.pt`` produced by ``metallo_drug_smoke_retrain.py``
        or any other training script that calls ``adapter.save(...)``.
        If the path does not exist or is empty, the function builds a
        fresh adapter at ``hidden_dim`` / ``n_layers`` and skips the
        ``load_state_dict`` step (the decode_ratio is then reported as
        ``0.0`` because no checkpoint was supplied — the envelope
        records ``checkpoint_loaded: False`` so callers can detect the
        fallback).
    n_samples, n_steps
        Sample size and ODE-step count (small defaults keep this fast).
    hidden_dim, n_layers
        Adapter architecture to construct when no checkpoint can be
        loaded.  ``hidden_dim=32`` triggers the production-under-scale
        warning in :meth:`LipmanFlowMatchingAdapter.setup` — that is
        intentional for a probe hook.

    Returns
    -------
    dict
        ``{"decode_ratio": float, "n_decoded": int, "n_samples": int,
           "checkpoint_loaded": bool, ...}``.
    """
    name = "decode_ratio"
    started = time.time()
    ckpt_path = Path(checkpoint_path)
    payload_extras: Dict[str, Any] = {
        "checkpoint_path": str(ckpt_path),
        "n_samples": int(n_samples),
        "n_steps": int(n_steps),
        "hidden_dim": int(hidden_dim),
        "n_layers": int(n_layers),
        "pocket_id": pocket_id,
        "checkpoint_loaded": False,
        "n_decoded": 0,
        "decode_ratio": 0.0,
    }

    try:
        from molmetal.adapters.flow_matching_lipman import LipmanFlowMatchingAdapter
        from molmetal.ports import GenerationConfig
    except Exception as exc:
        payload_extras["error"] = f"imports failed: {exc}"
        payload = _wrap(name, started, **payload_extras)
        if save:
            _save_metric(name, payload)
        return payload

    try:
        adapter = LipmanFlowMatchingAdapter(
            hidden_dim=int(hidden_dim), n_layers=int(n_layers),
        )
        adapter.setup(device="cpu")

        if ckpt_path.is_file():
            try:
                state = torch.load(ckpt_path, map_location="cpu")
                if isinstance(state, dict) and "state_dict" in state:
                    state = state["state_dict"]
                # Try the velocity field first, fall back to the whole
                # adapter.  strict=False so partial checkpoints don't
                # blow up.
                try:
                    adapter.velocity_field.load_state_dict(state, strict=False)
                except Exception:
                    adapter.load_state_dict(state, strict=False)
                payload_extras["checkpoint_loaded"] = True
            except Exception as exc:
                payload_extras["checkpoint_load_error"] = (
                    f"{type(exc).__name__}: {exc}"
                )

        pocket = resolve_pocket(pocket_id, n_atoms=32, radius=6.0)
        config = GenerationConfig(n_samples=int(n_samples),
                                  n_steps=int(n_steps), seed=42)
        mols = adapter.generate(pocket, config)
        n_decoded = sum(1 for m in mols
                         if m.bonds is not None and m.bonds.shape[-1] > 0)
        ratio = float(n_decoded) / max(1, int(n_samples))

        payload_extras["n_decoded"] = int(n_decoded)
        payload_extras["decode_ratio"] = ratio
    except Exception as exc:
        payload_extras["error"] = f"{type(exc).__name__}: {exc}"
        payload_extras["trace"] = traceback.format_exc(limit=4)

    payload = _wrap(name, started, **payload_extras)
    if save:
        _save_metric(name, payload)
    return payload


__all__ = [
    "compute_vina_min",
    "compute_multi_cell_auc",
    "compute_decode_ratio",
    "resolve_pocket",
    "METRIC_OUTPUT_DIR",
]