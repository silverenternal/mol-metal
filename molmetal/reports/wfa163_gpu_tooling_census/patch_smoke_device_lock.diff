 def _cpu_lock_on() -> bool:
     """True when this session has been forced onto the CPU."""
     return os.environ.get(MOLMETAL_TEST_ALLOW_GPU_ENV) != "1"
diff --git a/molmetal/scripts/infer_cfm.py b/molmetal/scripts/infer_cfm.py
--- a/molmetal/scripts/infer_cfm.py
+++ b/molmetal/scripts/infer_cfm.py
@@ -34,13 +34,41 @@
 DEFAULTS = {
     "input_file": "molecules.smi",
     "output_dir": "./predictions/",
-    "device": "cuda" if torch.cuda.is_available() else "cpu",
     "num_cycle": 1,
     "batch_size": 8,
     "max_smiles_len": 256,
 }
 
 
+def _default_device() -> str:
+    """The device this run uses when ``--device`` is not given.
+
+    Wf-A163 (2026-11-01).  The default used to be computed at IMPORT time
+    (``"device": "cuda" if torch.cuda.is_available() else "cpu"``), so merely
+    importing this module initialised CUDA and created a primary context on a
+    visible GPU -- before the operator had asked for any work at all.
+
+    Three changes, in order:
+
+    1. LAZY -- the probe runs when the arguments are parsed, not when the
+       module is imported.
+    2. THE SESSION LOCK WINS -- ``CUDA_VISIBLE_DEVICES=""`` (the repo's
+       no-GPU lock) forces ``cpu`` without probing at all.
+    3. EXPLICIT OVERRIDE -- ``MOLMETAL_SMOKE_DEVICE=cpu|cuda`` makes the
+       choice explicit, following the convention already used by
+       ``molmetal/scripts/metallo_drug_smoke_retrain.py::_resolve_device``.
+
+    The default in every other case is unchanged: the GPU whenever one is
+    available.
+    """
+    if os.environ.get("CUDA_VISIBLE_DEVICES", None) == "":
+        return "cpu"
+    override = (os.environ.get("MOLMETAL_SMOKE_DEVICE") or "").strip().lower()
+    if override in ("cpu", "cuda"):
+        return override
+    return "cuda" if torch.cuda.is_available() else "cpu"
+
+
 def parse_args(argv=None) -> argparse.Namespace:
