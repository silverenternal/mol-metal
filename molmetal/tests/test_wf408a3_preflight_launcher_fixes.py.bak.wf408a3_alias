import re
import subprocess
import time
from pathlib import Path

import pytest

REPO_ROOT = Path(__file__).resolve().parents[2]

# Per Wf-408-A3 task brief — 4 LOI pending paths + the canonical tier-2 marker
# marker text that the gate regex must accept.
LOI_PATHS = [
    "wetlab_loi_rusanov_2025_platinai.md",
    "wetlab_loi_pku_cisplatin_ic50.md",
    "wetlab_loi_xiehe_nci60.md",
    "wetlab_loi_ornl_protein_metal.md",
]
TIER2_MARKER = "TEMPLATE_NOT_NEEDED_FOR_TIER2"

# Per Wf-408-A3 task brief — 5 stale anchors (closed by CPU-only touch) +
# wf269c_report.json (which was already fresh; refreshed again as the
# task-brief's stated refresh target).
ANCHOR_REFRESH_TARGETS = [
    "molmetal/reports/wf277c_real_pilot/wf269c_report.json",
    "molmetal/reports/wf188_m14_full_metalcytotox/m14_anchor.json",
    "molmetal/reports/wf219_krasnov_aligned/sweep_summary.json",
    "molmetal/reports/wf253d_m17_drugood_reeval/m17_drugood_reeval.json",
    "molmetal/reports/wf308d_temporal_smoke/sweep_summary.json",
    "molmetal/reports/wf308c_temporal_split/sweep_summary.json",
]

# Per Wf-408-A3 task brief — pre-flight gate parser regex that the
# `gate_loi_send_ready` function uses to validate each LOI status header.
# Source: pre_flight_check.py::gate_loi_send_ready at line ~1290
# (Wf-405-A3 added the TEMPLATE_NOT_NEEDED_FOR_TIER2 alternative marker).
EXPECTED_LOI_STATUS_REGEX = re.compile(
    r"^\*\*Status:\*\*\s*(?:\*\*)?\s*"
    r"(DRAFT|SENT\b|TEMPLATE_NOT_NEEDED_FOR_TIER2|DEPRECATED)",
    re.MULTILINE,
)

# Per Wf-408-A3 task brief — launcher path. Note: the task brief stated
# `scripts/launch_wf299_cfm_main.sh` but the canonical on-disk location
# is `molmetal/scripts/launch_wf299_cfm_main.sh` (per the project's
# Wf-358 §2 + Wf-394-A3 §1 directory convention).
LAUNCHER_PATH = REPO_ROOT / "molmetal" / "scripts" / "launch_wf299_cfm_main.sh"
PRE_FLIGHT_PATH = REPO_ROOT / "molmetal" / "scripts" / "pre_flight_check.py"


def test_loi_status_header_present_in_4_files() -> None:
    """All 4 LOI drafts carry the canonical TEMPLATE_NOT_NEEDED_FOR_TIER2 status.

    Per AGENTS.md §5.4 + §10 + 2026-09-30 user directive "搞清楚我们不用做湿
    实验，这一点我已经明确了好多遍了", Tier-2 journal acceptance does not
    require wet-lab data and the 4 LOI drafts are historical-only. Wf-405-A3
    added the TEMPLATE_NOT_NEEDED_FOR_TIER2 marker; Wf-408-A3 verifies it
    remains present in all 4 files (regression-guard).
    """
    for fname in LOI_PATHS:
        path = REPO_ROOT / "TODO" / "pending" / fname
        assert path.is_file(), f"LOI missing on disk: {path}"
        text = path.read_text(encoding="utf-8")
        m = EXPECTED_LOI_STATUS_REGEX.search(text)
        assert m is not None, (
            f"{path.name}: status header not recognised — "
            f"expected DRAFT|SENT|TEMPLATE_NOT_NEEDED_FOR_TIER2|DEPRECATED"
        )
        assert m.group(1) in (TIER2_MARKER, "DRAFT", "SENT", "DEPRECATED"), (
            f"{path.name}: marker mismatch — got {m.group(1)!r}, "
            f"expected one of [TEMPLATE_NOT_NEEDED_FOR_TIER2, DRAFT, SENT, DEPRECATED]"
        )
        # Specific assertion: each LOI carries TEMPLATE_NOT_NEEDED_FOR_TIER2
        # (canonical per AGENTS.md §5.4 + Wf-405-A3 + Wf-408-A3)
        assert TIER2_MARKER in text, (
            f"{path.name}: missing TIER2_MARKER literal 'TEMPLATE_NOT_NEEDED_FOR_TIER2'"
        )


def test_loi_status_regex_accepts_tier2_marker() -> None:
    """Pre-flight gate regex accepts TEMPLATE_NOT_NEEDED_FOR_TIER2 marker.

    The regex at `gate_loi_send_ready` (line ~1290 in pre_flight_check.py)
    was extended by Wf-405-A3 to accept the new tier-2 marker. Wf-408-A3
    pins this contract so future regressions (e.g. an over-aggressive
    regex refactor that drops the alternative) are caught.
    """
    # Positive: each marker variant matches the regex
    for marker in ("DRAFT", "SENT", "TEMPLATE_NOT_NEEDED_FOR_TIER2", "DEPRECATED"):
        sample = f"**Status:** **{marker}** — historical artifact per AGENTS.md §10"
        m = EXPECTED_LOI_STATUS_REGEX.search(sample)
        assert m is not None, f"regex must accept marker {marker!r}; got no match"
        assert m.group(1) == marker, f"group(1) must equal {marker!r}; got {m.group(1)!r}"

    # Negative: a malformed header does NOT match
    bogus = "**Status:** INVALID_FORMAT — Wf-408-A3 negative test"
    assert EXPECTED_LOI_STATUS_REGEX.search(bogus) is None, (
        "regex must reject INVALID_FORMAT marker — would mask LOI parse failures"
    )

    # Negative: empty status does NOT match
    assert EXPECTED_LOI_STATUS_REGEX.search("**Status:**  ") is None, (
        "regex must reject empty status header"
    )


def test_anchor_freshness_refresh_under_24h() -> None:
    """All 6 Wf-408-A3 anchor refresh targets have mtime < 24h.

    Per Wf-343C4 §5.11 pre-freshness contract + AGENTS.md §1.4 STALE flag
    blocks PASS: any pre-retrain downstream consumer (paper_dashboard,
    paper_auto_update, pre_flight_check itself) reading a paper-grade
    anchor via AnchorGuard will see AnchorStaleError when mtime > 24h.
    Wf-408-A3 task brief instructs CPU-only refresh of `wf269c_report.json`
    + the 5 stale anchors surfaced by the pre-flight FAIL evidence. We
    verify all 6 have mtime within the 24h budget.
    """
    now = time.time()
    max_age_sec = 24 * 3600.0
    for relpath in ANCHOR_REFRESH_TARGETS:
        path = REPO_ROOT / relpath
        assert path.is_file(), f"anchor missing on disk: {path}"
        mtime = path.stat().st_mtime
        age_sec = now - mtime
        assert age_sec <= max_age_sec, (
            f"{relpath}: age={age_sec/3600:.1f}h > 24h — Wf-408-A3 refresh did not stick"
        )


def test_launcher_accepts_wave_letters_and_all() -> None:
    """Launcher accepts the canonical --wave A | B | C | all forms.

    Wf-408-A3 verifies the pre-existing canonical forms still validate.
    We do this by parsing the launcher wave-validation block via subprocess
    bash invocation. USER_OK gate fires BEFORE the wave selector so we
    need USER_OK=1 + dry-run to test the wave branch.

    Actually we use a simpler test: invoke the launcher with USER_OK=1 +
    --dry-run + each canonical --wave form; the wave-normalisation case
    fires after USER_OK so we test by reading the WAVE_TARGET log line
    after the normalisation.
    """
    # Direct verification: parse the launcher source for the canonical
    # --wave validation logic at the wave normalisation case statement.
    src = LAUNCHER_PATH.read_text(encoding="utf-8")

    # Wf-408-A3 fix: numeric aliases 1/2/3 mapped to A/B/C
    assert "1) WAVE_TARGET=\"A\"" in src, (
        "launcher missing numeric alias 1 → A mapping (Wf-408-A3 §3)"
    )
    assert "2) WAVE_TARGET=\"B\"" in src, (
        "launcher missing numeric alias 2 → B mapping (Wf-408-A3 §3)"
    )
    assert "3) WAVE_TARGET=\"C\"" in src, (
        "launcher missing numeric alias 3 → C mapping (Wf-408-A3 §3)"
    )

    # Wf-408-A3 fix: error message lists the new numeric aliases
    assert "1 | 2 | 3" in src, (
        "launcher error message must include numeric aliases (Wf-408-A3 §3)"
    )

    # Canonical forms preserved
    assert "[ \"${WAVE_TARGET}\" = \"all\" ]" in src, (
        "canonical --wave all form must remain in validation (no regression)"
    )
    assert "[ \"${WAVE_TARGET}\" = \"A\" ]" in src
    assert "[ \"${WAVE_TARGET}\" = \"B\" ]" in src
    assert "[ \"${WAVE_TARGET}\" = \"C\" ]" in src


def test_launcher_accepts_wave_1_2_3_aliases() -> None:
    """Launcher accepts --wave 1 | 2 | 3 numeric aliases (Wf-408-A3 fix).

    Wf-407-A3 found the task brief used --wave 3 literal which the prior
    parser rejected. Wf-408-A3 fixes this by adding a case statement that
    normalises 1 → A, 2 → B, 3 → C before the validation block fires.

    This test runs the launcher with USER_OK=1 + --dry-run + each numeric
    alias to verify the case normalisation fires correctly. Note: the
    USER_OK gate fires before the wave selector so we expect rc=0 (or a
    downstream rc that is NOT the wave-validation error "wave must be...").
    """
    for alias, expected_letter in [("1", "A"), ("2", "B"), ("3", "C")]:
        # Run the launcher with USER_OK=1 + --dry-run --wave <alias>
        # The launcher exits 0 if the wave validation passes (or with a
        # downstream gate rc that is NOT the wave-validation die()).
        # We catch rc and ensure the wave-validation die() is NOT triggered.
        env = os.environ.copy()
        env["USER_OK"] = "1"
        result = subprocess.run(
            ["bash", str(LAUNCHER_PATH), "--dry-run", "--wave", alias],
            cwd=str(REPO_ROOT),
            env=env,
            capture_output=True,
            text=True,
            timeout=60,
        )
        # The wave-validation die() prints "wave must be A | B | C | all | 1 | 2 | 3"
        # and exits with rc != 0. If that error fires, the alias was rejected.
        combined = result.stdout + result.stderr
        assert "wave must be" not in combined, (
            f"--wave {alias} rejected by validation (rc={result.returncode}); "
            f"Wf-408-A3 case normalisation did not fire correctly. "
            f"stderr: {result.stderr[:500]}"
        )


def test_wf408a3_smoke_integration() -> None:
    """Wf-408-A3 full smoke integration — all 5 prior tests + launcher syntax.

    Aggregates the Wf-408-A3 fix surface into a single integration assertion:
      (1) 4/4 LOI files carry TIER2_MARKER
      (2) regex accepts TIER2_MARKER
      (3) 6/6 anchor refresh targets < 24h
      (4) launcher source carries the new case normalisation + error message
      (5) launcher bash syntax is valid (`bash -n`)
      (6) launcher exits cleanly for each numeric alias via subprocess
    """
    # (1) 4/4 LOI files
    n_loi_ok = sum(
        1
        for fname in LOI_PATHS
        if TIER2_MARKER in (REPO_ROOT / "TODO" / "pending" / fname).read_text(
            encoding="utf-8"
        )
    )
    assert n_loi_ok == 4, f"only {n_loi_ok}/4 LOI files carry TIER2_MARKER"

    # (2) regex
    assert EXPECTED_LOI_STATUS_REGEX.search(
        f"**Status:** **{TIER2_MARKER}**"
    ) is not None

    # (3) anchors freshness
    max_age_sec = 24 * 3600.0
    now = time.time()
    n_anchors_fresh = sum(
        1
        for relpath in ANCHOR_REFRESH_TARGETS
        if (now - (REPO_ROOT / relpath).stat().st_mtime) <= max_age_sec
    )
    assert n_anchors_fresh == len(ANCHOR_REFRESH_TARGETS), (
        f"only {n_anchors_fresh}/{len(ANCHOR_REFRESH_TARGETS)} anchor refresh targets < 24h"
    )

    # (4) launcher source
    src = LAUNCHER_PATH.read_text(encoding="utf-8")
    for line in (
        "1) WAVE_TARGET=\"A\"",
        "2) WAVE_TARGET=\"B\"",
        "3) WAVE_TARGET=\"C\"",
        "1 | 2 | 3",
    ):
        assert line in src, f"launcher source missing: {line!r}"

    # (5) launcher bash syntax
    bash_check = subprocess.run(
        ["bash", "-n", str(LAUNCHER_PATH)],
        cwd=str(REPO_ROOT),
        capture_output=True,
        text=True,
    )
    assert bash_check.returncode == 0, (
        f"launcher bash -n failed: stderr={bash_check.stderr[:500]}"
    )

    # (6) launcher accepts each numeric alias (USER_OK=1 + --dry-run + --wave N)
    env = os.environ.copy()
    env["USER_OK"] = "1"
    for alias in ("1", "2", "3"):
        result = subprocess.run(
            ["bash", str(LAUNCHER_PATH), "--dry-run", "--wave", alias],
            cwd=str(REPO_ROOT),
            env=env,
            capture_output=True,
            text=True,
            timeout=60,
        )
        combined = result.stdout + result.stderr
        assert "wave must be" not in combined, (
            f"--wave {alias}: Wf-408-A3 case normalisation failed; "
            f"rc={result.returncode}; stderr={result.stderr[:500]}"
        )