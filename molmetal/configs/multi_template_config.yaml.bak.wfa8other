# =============================================================================
# Canonical multi-template + MM-GBSA configuration (Wf-380-A5)
# =============================================================================
# This config drives the multi-template dock + MM-GBSA rescoring pipeline
# for the m15 Docking RMSD metric (TODO-204 / Wf-299 §1 task 5).
#
# Defaults follow the canonical Wf-179 BD-9 + Wf-246-B + Wf-247-A baseline
# (5-pocket organic-cofactor set, 3 seeds, 5 poses per seed).  The
# multi-template extension widens the bench along the template axis
# (default 5 templates; bench lifts up to 20) and adds a closed-form
# MM-GBSA surrogate for rescore.
#
# Honest framing (party-twenty-spirit §3.5)
# -----------------------------------------
# - Multi-template + MM-GBSA on REAL Vina + GBSA binaries is deferred
#   to TODO-207 (Wf-299 launch).  This config currently drives the
#   surrogate closed-form bench only.
# - All smoke numeric values are synthetic via ``wf380a5_multi_template_..``
#   ``_synthetic_rmsd_grid`` + ``_synthetic_mmgbsa_kcal`` helpers.
# - The "real" backend path raises NotImplementedError until the
#   meeko / Vina / GBSA toolchain is integrated (TODO-207 / Wf-299).
# =============================================================================

# Test cohort — canonical 5-pocket organic-cofactor set
test_set: docked_pose_rmsd_canonical
n_test_pockets: 5

# Canonical pocket list (matches Wf-179 BD-9 + Wf-341-T1 + Wf-247-A)
pockets:
  - "1h36"
  - "3eml"
  - "3ny8"
  - "4aaw"
  - "4rlu"

# Multi-template config
# ---------------------
# Number of homologous templates to dock against per pocket.
# Lifted from single-template (5) -> 20 to expose the
# best-of-template gain axis.  Per Wf-380-A5 brief, projected lift
# is -0.10 to -0.15 A RMSD at n_templates=20 vs n_templates=1.
n_templates: 5           # bench default (smoke)
n_templates_extended: 20 # Wf-299 production (deferred to TODO-207)

# Vina pose count per template
n_poses: 9               # TargetDiff / SOTA default (Guan 2023)
n_poses_extended: 20     # Wf-299 production (deferred to TODO-207)

# Vina exhaustiveness — same as canonical Wf-179 BD-9 + Wf-246-B
docking:
  engine: vina
  version: "1.2.7"
  exhaustiveness: 8

# MM-GBSA rescoring config
# ------------------------
# Closed-form surrogate parameters.  Real binaries would consume
# ambertools ``MMPBSA.py`` or ``gmx_MMPBSA`` (deferred to TODO-207).
mm_gbsa:
  backend: surrogate      # "surrogate" or "real" (NotImplementedError)
  gas_constant_kcal: 0.5961
  born_implicit_solvent_kcal: -5.0
  sa_nonpolar_kcal_per_a2: 0.005

# SOTA success gates (transferred from Wf-341-T1 m15 redesign)
sota:
  rmsd_threshold_angstrom: 2.0
  practical_threshold_angstrom: 2.5
  per_pocket_success_rate: 0.80

# Expected lift (PROJECTED — not MEASURED on real Vina + GBSA yet)
# per Wf-380-A5 brief
expected_lift:
  min_angstrom: -0.10
  max_angstrom: -0.15
  cohort: 5-pocket organic-cofactor (1h36 + 3eml + 3ny8 + 4aaw + 4rlu)
  baseline_source: "metrics/by_metric/docked_pose_rmsd.json"

# Output paths
outputs:
  result_json: "molmetal/reports/wf380a5_multi_template_smoke/result.json"
  config_path: "molmetal/configs/multi_template_config.yaml"

# Cross-references
# ----------------
# - molmetal/scripts/wf380a5_multi_template_mm_gbsa.py — this Wf's module
# - molmetal/scripts/wf341t1_m15_rmsd_redesign.py — single-template baseline
# - molmetal/scripts/cfm_vina_dock_panel.py — upstream meeko + Vina
# - TODO/pending/207_wf299_cfm_3wave_launch.md — parent launch plan
# - TODO/pending/204_m15_rmsd_multidocking_mm_gbsa.md — TODO-204 spec