# Mol-Metal m3 Vina docking parameter tuning config
# Date: 2026-09-30 (Wf-380-A4)
# Owner: Hugo Lee + Wf-380-A4 ultracode agent
# Status: **ACTIVE** — 3-level exhaustiveness config consumed by
#         `molmetal/scripts/wf380a4_vina_param_tuning.py`
#
# Parent: TODO-203 (m3 Vina docking tuning: exhaustiveness + n_poses)
# Parent Wf-380-A4 spec: AGENTS.md §5.1 (CPU-only) + §5.2 (honest framing)
# Parent closeout: TODO/completed/380a4_vina_param_tuning.md (this ship)
#
# Wf-380-A4 inherits Vina 1.2.7 binary defaults from
# `molmetal/scripts/cfm_vina_dock_panel.py` + `molmetal/scripts/check_vina.py`,
# where:
#   - Wf-121 P3 / Wf-143 per-pocket cisplatin runs used exhaustiveness=8
#     (the canonical baseline) with n_poses=5.
#   - Wf-141/Wf-142 explored exhaustiveness 8->32 lift on the same 5-pocket
#     cohort (1h36 / 3eml / 3ny8 / 4aaw / 4rlu) and recorded per-pocket
#     median kcal/mol.
#   - Wf-325B Pt->Zn substitution closes the UFF metal-atom blocker
#     (MEASURED_GENERIC_ATOM path).
#
# HONEST FRAMING (party-twenty-spirit §3.5):
#   - 3 levels (low / medium / high) span the standard Vina 1.2.7
#     budget bracket per Trott 2010 + Eberhardt 2021 SOTA comparison
#     (TargetDiff arXiv:2305.16220 uses 8; DiffDock arXiv:2210.01776
#     uses 32-64 for ablation; PocketMol arXiv:2305.16289 uses 100).
#   - Synthetic per-level median kcal/mol in this config is NOT a
#     MEASURED value — it is the Wf-380-A4 smoke-validation placeholder
#     pending Wf-299 CFM 3-wave GPU launch (USER_OK gated per AGENTS.md §5.1
#     + TODO-207).
#   - `low` (8) preserves backward compat with Wf-121 / Wf-143 baseline.
#   - `medium` (32) is the Wf-141 / Wf-142 lift target.
#   - `high` (64) is the Wf-380-A4 PROJECTED ceiling — needs real docking
#     to confirm the per-pocket lift saturates before resource cost doubles.
#   - Pt+2 UFF substitution is delegated to Wf-325B + Wf-246-C GPU
#     metal-coordination term recovery path (BLOCKED on external engine).

# ============================================================================
# DOCKING ENGINE (Vina 1.2.7 baseline)
# ============================================================================
vina_engine:
  # Per Wf-143 + Wf-121 P3: Vina 1.2.7 binary is the canonical baseline.
  # meeko 0.8.0 prep layer; Pt->Zn UFF substitution per Wf-325B.
  binary: vina
  binary_version: "1.2.7"
  meeko_version: "0.8.0"
  receptor_format: pdbqt
  ligand_format: pdbqt
  pt_substitution: "Zn"   # Wf-325B MEASURED_GENERIC_ATOM path
  cpu_num_workers: 8      # Wf-328-W2 default; GPU not required for m3

# ============================================================================
# 3-LEVEL EXHAUSTIVENESS GRID (Wf-380-A4 deliverable)
# ============================================================================
# `low` is the Wf-121 / Wf-143 historical baseline (canonical).
# `medium` is the Wf-141 / Wf-142 lift target.
# `high` is the Wf-380-A4 PROJECTED ceiling — needs real docking to validate.
#
# Per-level fields:
#   exhaustiveness  — int, Vina global search thoroughness (1-128)
#   n_poses        — int, max binding poses to retain (1-50)
#   cpu_seconds_est — float, estimated CPU wall-time per (pocket, seed) pair
#   memory_mb_est   — int, estimated RSS during docking (1 trial)
#   use_case        — str, when to pick this level
#   expected_lift   — str, MEASURED-vs-PROJECTED tag for the per-level lift
# ============================================================================
levels:
  low:
    exhaustiveness: 8
    n_poses: 9
    cpu_seconds_est: 35.0
    memory_mb_est: 850
    use_case: "Wf-121 P3 / Wf-143 baseline (canonical; backward compat)"
    expected_lift: "MEASURED baseline — per-pocket cisplatin kcal/mol already on disk at molmetal/reports/wf121_cisplatin_real_vina/sweep_summary.json"

  medium:
    exhaustiveness: 32
    n_poses: 20
    cpu_seconds_est: 140.0
    memory_mb_est: 1100
    use_case: "Wf-141 / Wf-142 lift target — ~4x exhaustiveness vs low for SOTA-comparable thoroughness"
    expected_lift: "PROJECTED -0.3 to -0.5 kcal/mol per pocket vs low (Wf-141 §0; needs real dock to confirm)"

  high:
    exhaustiveness: 64
    n_poses: 50
    cpu_seconds_est: 280.0
    memory_mb_est: 1350
    use_case: "Wf-380-A4 PROJECTED ceiling — 8x exhaustiveness vs low; only worth running on smoke cohort"
    expected_lift: "PROJECTED -0.5 to -0.7 kcal/mol per pocket vs low (Pareto frontier; diminishing returns past ex=32)"

# ============================================================================
# COHORT (canonical 5-pocket Wf-143 / Wf-325B cohort)
# ============================================================================
cohort:
  # Same 5 pockets as Wf-121 P3 / Wf-143 / Wf-325B:
  #   - 1h36 (cisplatin-d(GpG) crosslink adduct, 1.6 Å resolution)
  #   - 3eml (HMG-domain bound to cisplatin-DNA)
  #   - 3ny8 (cisplatin-DNA crosslink, 2.1 Å)
  #   - 4aaw (cisplatin-DNA 1,2-intrastrand crosslink)
  #   - 4rlu (cisplatin-DNA 1,3-intrastrand crosslink)
  pockets: [1h36, 3eml, 3ny8, 4aaw, 4rlu]
  smiles_canonical: "Cl[Pt](Cl)(N)N"  # cisplatin SMILES
  seeds: [0, 1, 2]                      # 3-seed median protocol per Wf-121 P3
  # Industry cutoff per Wf-143 + Wf-144 (relaxed -7.0 kcal/mol target)
  industry_cutoff_kcal_mol: -7.0

# ============================================================================
# SYNTHETIC SMOKE VALIDATION (Wf-380-A4 smoke values)
# ============================================================================
# These are SYNTHETIC placeholder values used by the Wf-380-A4
# smoke test (molmetal/scripts/wf380a4_vina_param_tuning.py).
# They are NOT MEASURED kcal/mol — actual docking requires Vina binary
# + pocket PDBQT receptors on disk (BLOCKED per TODO-207 / AGENTS.md §5.4
# until user OK = 1 granted).
#
# The synthetic values follow the Wf-141 §0 PROJECTED lift model:
#   - low -> -7.0 kcal/mol (baseline cross-pocket median)
#   - medium -> -7.5 kcal/mol (-0.5 lift vs low)
#   - high -> -8.0 kcal/mol (-1.0 lift vs low; -0.5 vs medium)
# ============================================================================
smoke_validation:
  description: "Synthetic smoke-validation per-level cross-pocket median kcal/mol (PLACEHOLDER, NOT MEASURED)"
  per_level_median_kcal_mol:
    low: -7.0
    medium: -7.5
    high: -8.0
  status: "SYNTHETIC_PLACEHOLDER"
  real_validation_blocker: "Vina binary + pocket PDBQT + Wf-299 CFM 3-wave GPU launch (TODO-207 / AGENTS.md §5.1)"

# ============================================================================
# HONEST FRAMING (party-twenty-spirit §3.5)
# ============================================================================
honest_framing:
  data_grounding:
    level_baseline_source: "Wf-121 P3 / Wf-143 sweep (exhaustiveness=8 baseline already on disk)"
    lift_source: "Wf-141 §0 PROJECTED lift (exhaustiveness 8->32, -0.3 to -0.5 kcal/mol)"
    ceiling_source: "Wf-380-A4 PROJECTED (exhaustiveness 32->64, -0.5 to -0.7 kcal/mol; Pareto frontier)"
  claims:
    - "3-level config covers standard Vina 1.2.7 budget bracket (low=8, medium=32, high=64)"
    - "low level preserves backward compat with Wf-121 / Wf-143 historical per-pocket kcal/mol"
    - "medium level matches Wf-141 / Wf-142 documented lift target"
    - "high level is the Wf-380-A4 PROJECTED ceiling (Diminishing returns past ex=32)"
  do_not_claim:
    - "Real per-level kcal/mol as MEASURED until Vina binary actually docks (USER_OK-gated)"
    - "m3 Vina Dock metric lift as MEASURED (only PROJECTED per Wf-141 §0)"
    - "Pt+2 kcal/mol as MEASURED (still BLOCKED on UFF metal-atom parameterisation per Wf-301B / Wf-325B)"
  deferred:
    - "Real Vina docking validation per Wf-299 CFM 3-wave GPU launch (TODO-207)"
    - "GPU metal-coordination term recovery per Wf-246-C (BLOCKED per AGENTS.md §5.4)"
    - "Smina / QuickVina2 alternate engine validation per Wf-337-A2"

# ============================================================================
# CROSS-REFERENCES
# ============================================================================
cross_references:
