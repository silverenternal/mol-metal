# TODO-119 P1.4 — Per-innovation CFM ablation (YuelBond / W2 / closure)
# Date: 2026-09-28 (Wf-258-Prepare dry-run config)
# Owner: Hugo Lee + ultracode agent
# Status: DRY-RUN (--dry-run mode; no GPU execution)
#
# Parent: TODO-119 P1.4 — per-innovation CFM ablation (YuelBond only / W2
# only / closure only / all-combined control).
# Parent audit: molmetal/reports/wf258_audit/cfm_todo_gap_audit.md §1.2
# Parent TODO: TODO/completed/119_decode_ratio_strengthen.md §3
# Wf-257 §5.1 cite: Wf-257 §5.1 (CFM TODO shortlist, entry 2)
#
# HONEST FRAMING (party-twenty-spirit §3.5):
# - Current Wf-124 P2 decode_ratio = 1.000 (synthetic) is AGGREGATE of 3
#   simultaneous innovations; per-lever attribution NOT measured.
# - Per-lever attribution is a paper §3 algorithm-description hard requirement
#   (party-twenty-spirit §3.5).
# - Ablation interaction term may be large (>30% of total lift per TODO-182 §3.4
#   hypothesis); do NOT cite per-lever % as MEASURED until 4 ablations complete.

dry_run: true          # skip GPU; CPU verification only
user_ok_required: true  # per kill_then_adapt standing directive

# ============================================================================
# DATA — REAL CSV (NOT synthetic)
# ============================================================================
data:
  csv: .data/molmetal/metalcytotox_5metal_multitask_v2.csv
  n_rows_expected: 26632   # v2 26633 lines - 1 header = 26632 rows (per Wf-261 strict scaffold split; 169 null-scaffold rows dropped)
  expected_columns_subset: [smiles, metal, pic50, source]
  cohort_filter:
    metals: [Ru, Ir, Os, Rh, Re]
    # Wf-261 strict Bemis-Murcko scaffold 70/10/20 split (0 leak; 3069 unique scaffolds)
    scaffold_split: true

# ============================================================================
# MODEL — 4 ablation configs (backbone shared; ablate per-innovation flags)
# ============================================================================
model:
  backbone: chemprop_v2_mt
  hidden_dim: 128
  n_layers: 3
  atom_vocab_size: 14
  bond_head: learned
  joint_train: true
  cfm_decoder: yuelbond

# ============================================================================
# FLOW MATCHING (shared across all 4 ablations)
# ============================================================================
flow:
  n_steps: 100
  method: rk4
  ot_solver: w_flow

# ============================================================================
# TRAINING PROTOCOL — 4 ablation configs x 1 seed x 3 epochs (~2 hr total)
# ============================================================================
protocol:
  n_seeds: 1
  seeds: [0]
  epochs: 3                          # small smoke per ablation
  batch_size: 16
  lr: 1.0e-4
  warmup_steps: 50
  grad_clip_norm: 1.0
  ema_decay: 0.999
  edge_cutoff: 6.0
  bf16: true

# ============================================================================
# 4 ABLATION CONFIGURATIONS
# ============================================================================
ablation_configs:
  a_full_stack:
    description: "Full stack (YuelBond + W2 + Catherine) — Wf-124 P2 control"
    flags:
      - --use-yuelbond
      # wasserstein on by default
      # closure_bounded on by default
    expected_per_metric:
      decode_ratio: 0.7              # PROJECTED — synthetic 1.0 not real-cohort
      wasserstein_loss: 0.4
      catherine_pass_rate: 0.95
  b_yuelbond_only:
    description: "YuelBond only (no W2, no Catherine)"
    flags:
      - --use-yuelbond
      - --no-wasserstein
      - --no-closure-bounded
    expected_per_metric:
      decode_ratio: 0.6              # PROJECTED — single lever
      wasserstein_loss: 0.0          # disabled
      catherine_pass_rate: 0.80      # PROJECTED — no closure reg
  c_w2_only:
    description: "W2 only (no YuelBond, no Catherine)"
    flags:
      - --no-yuelbond
      # wasserstein on by default
      - --no-closure-bounded
    expected_per_metric:
      decode_ratio: 0.4              # PROJECTED — weakest lever
      wasserstein_loss: 0.4
      catherine_pass_rate: 0.80
  d_catherine_only:
    description: "Catherine only (no YuelBond, no W2)"
    flags:
      - --no-yuelbond
      - --no-wasserstein
      # closure_bounded on by default
    expected_per_metric:
      decode_ratio: 0.5              # PROJECTED — closure reg helps validity
      wasserstein_loss: 0.0
      catherine_pass_rate: 0.95

# ============================================================================
# EVALUATION
# ============================================================================
eval:
  per_config_metrics:
    - decode_ratio                   # m14 — primary CFM metric
    - wasserstein_loss               # W2 trajectory
    - catherine_pass_rate            # 6/6 closure per metal
  target_decode_ratio: 0.5           # MEASURED from current 0.0 honest-negative

# ============================================================================
# OUTPUT — project root results/ per user 2026-09-28 instruction
# ============================================================================
output:
  base_dir: results/cfm_per_innovation_ablation_p1.4
  per_config_dir: results/cfm_per_innovation_ablation_p1.4/{config_name}
  metrics_json: results/cfm_per_innovation_ablation_p1.4/ablation_report.json
  log_master: results/cfm_per_innovation_ablation_p1.4/master.log

# ============================================================================
# WAVES — ~2 hr total on PRO 6000, split into 4 waves (~30 min each)
# ============================================================================
waves:
  total_waves: 4
  wave_a:
    description: "Full stack control (YuelBond + W2 + Catherine)"
    ablation_config: a_full_stack
    seeds: [0]
    epochs: 3
    wall_time_estimate: 0.5          # hr on PRO 6000
  wave_b:
    description: "YuelBond only"
    ablation_config: b_yuelbond_only
    seeds: [0]
    epochs: 3
    wall_time_estimate: 0.5
  wave_c:
    description: "W2 only"
    ablation_config: c_w2_only
    seeds: [0]
    epochs: 3
    wall_time_estimate: 0.5
  wave_d:
    description: "Catherine only"
    ablation_config: d_catherine_only
    seeds: [0]
    epochs: 3
    wall_time_estimate: 0.5
  total_wall_time_estimate: 2.0      # hr on PRO 6000

# ============================================================================
# COMPUTE
# ============================================================================
compute:
  gpu: cuda:0                        # RTX PRO 6000 Blackwell
  cpu_workers: 4
  bf16: true

# ============================================================================
# STANDING DIRECTIVES
# ============================================================================
directives:
  kill_then_adapt: true
  time_budget: 10h                   # user 2026-09-28 standing budget
  user_ok_required: true
  user_ok_granted: "pending — DRY-RUN only"
  per_wave_user_ok_required: true

# ============================================================================
# ENTRY POINT — reference existing script (do NOT recreate)
# ============================================================================
entry:
  # Reuses Wf-124 P2 shipped CFM trainer; has --no-yuelbond, --no-wasserstein,
  # --no-closure-bounded flags (confirmed via --help output).
  script: molmetal/scripts/train_cfm_yuelbond_wasserstein.py
  command: |
    CUDA_VISIBLE_DEVICES=0 /home/hugo/codes/CadButEaas/.venv-vlm/bin/python \\
      molmetal/scripts/train_cfm_yuelbond_wasserstein.py \\
      --epochs {epochs} \\
      {flags_joined} \\
      --pocket-id {pocket_id} \\
      --seed {seed} \\
      --out-dir {out_dir}

  warm_start_checkpoint: molmetal/checkpoints/cfm_yuelbond_wasserstein.pt
  # 617 KB Wf-124 P2 best ckpt (synthetic) — informational only.

# ============================================================================
# HONEST FRAMING (party-twenty-spirit §3.5)
# ============================================================================
honest_framing:
  claims:
    - "Per-innovation CFM ablation: YuelBond / W2 / Catherine / all-combined"
    - "4 ablation configs x 1 seed x 3 epochs, ~2 hr on PRO 6000"
    - "Per-lever attribution matrix (4 ablations) for paper §3 honesty"
  do_not_claim:
    - "Aggregate lift before per-lever attribution"
    - "Per-lever percentages as MEASURED until all 4 ablations complete"
    - "Interaction term sign or magnitude (may be >30% per TODO-182 §3.4)"
  deferred:
    - "Cross-leverage interaction runs (3 pairwise interactions: YuelBond x W2,
       YuelBond x Catherine, W2 x Catherine) — would double wave count to 8"
    - "Per-cohort (PlatinAI / DrugOOD) cross-tabulation"
    - "ablation_report.json write + audit (post-wave)"

# ============================================================================
# CROSS-REFERENCES
# ============================================================================
cross_references:
  - molmetal/reports/wf258_audit/cfm_todo_gap_audit.md
  - TODO/completed/119_decode_ratio_strengthen.md
  - TODO/pending/182_wf124_p3_per_innovation_ablation.md
  - molmetal/reports/wf257_research/cfm_potential.md
  - configs/cfm_full_retrain.yaml
  - molmetal/scripts/train_cfm_yuelbond_wasserstein.py
  - molmetal/checkpoints/cfm_yuelbond_wasserstein.pt