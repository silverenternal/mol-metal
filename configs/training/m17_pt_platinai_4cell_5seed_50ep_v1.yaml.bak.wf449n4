# Wf-A2 NEW: M17 Pt × 4-cell × 5-seed × 50-epoch canonical training config.
#
# HONEST FRAMING (party-twenty-spirit §3.5):
# - The harness task brief referenced "M17 Pt × 4-cell × 5-seed × 50-epoch".
#   Per TODO/02_metrics/MECHANISM_METRIC_MAPPING.md, M17 is the
#   "Reference loader flat-clone auto-detect" MECHANISM, not a training
#   config ID. There is no existing "M17 training config" canonical
#   config — this YAML authors a NEW canonical training config matching
#   the harness brief's protocol (Pt × PlatinAI 4-cell × 5-seed × 50-epoch)
#   for ONE canonical retrain target, NOT a refactor of an existing
#   "M17 training config". Name kept verbatim to match the brief.
# - Status: SCAFFOLD-only (Wf-A2 CPU-only docs+code+test wave; no GPU
#   launch per AGENTS.md §5.1 standing GPU grant + kill_then_adapt §0).
# - Data grounding: PlatinAI 4-cell pIC50 cohort per Rusanov 2025
#   (A2780 + MCF7 + A549 + A2780cis cisplatin-resistant); 4-cell cohort
#   matches Wf-13 P1 / Wf-379-A1 / Wf-260 patterns.
# - Bit-for-bit backward compat: no --config = argparse-only path.

# ============================================================================
# DATA — REAL PlatinAI 4-cell cohort (Pt-coordination pIC50)
# ============================================================================
data:
  dataset: platinai_4cell
  cohort_filter:
    metals: [Pt]
    cells: [A2780, MCF7, A549, A2780cis]
  expected_columns_subset: [smiles, metal, cell, pic50, source]

# ============================================================================
# MODEL — D-MPNN multi-task Wasserstein pIC50 (50-ep protocol)
# ============================================================================
model:
  backbone: chemprop_v2_v3
  ablation_config: mtl_baseline
  hidden_dim: 300
  depth: 3
  wasserstein_weight: 0.05
  alpha: 0.5
  n_mc: 256
  w2_gradient_mode: sliced
  use_l2_guard: true

# ============================================================================
# TRAINING PROTOCOL — 1 × 5 × 50 (Pt × 5-seed × 50-epoch)
# ============================================================================
protocol:
  n_seeds: 5
  seeds: [0, 1, 2, 3, 4]
  epochs: 50
  batch_size: 64
  lr: 1.0e-3
  grad_clip_norm: 5.0
  bf16: true
  # Wf-A5 N3 — wall-clock runtime ceiling per (metal, seed) pair (Wf-A5
  # follow-up design field §3); trainer knows to stop even mid-epoch
  # if the cumulative wall_seconds exceeds this budget.  Combined with
  # checkpoint_interval, a Ctrl+C / SIGTERM triggers a graceful exit
  # that writes the latest state to disk (post-loop save) so the next
  # invocation can resume.  24h is the upper-bound wall budget for a
  # single (metal, seed) pair on RTX PRO 6000 Blackwell @ 50-ep protocol.
  max_runtime_hr: 24
  enumerated_runs:
    - {metal: Pt, seed: 0}
    - {metal: Pt, seed: 1}
    - {metal: Pt, seed: 2}
    - {metal: Pt, seed: 3}
    - {metal: Pt, seed: 4}
  n_runs_total: 5

# ============================================================================
# EVALUATION
# ============================================================================
eval:
  per_pair_metrics: [test_auc, val_auc, wasserstein_final, best_epoch]
  target_test_auc: 0.86  # Krasnov 2026 — PROJECTED (NOT MEASURED)

# ============================================================================
# OUTPUT — REPO_ROOT results/ per project convention
# ============================================================================
output:
  base_dir: results/m17_pt_platinai_4cell_5seed_50ep
  per_metal_dir: results/m17_pt_platinai_4cell_5seed_50ep/{metal}/per_seed_metrics_seed{seed}.json
  training_summary: results/m17_pt_platinai_4cell_5seed_50ep/training_summary.json
  log_master: results/m17_pt_platinai_4cell_5seed_50ep/master.log
  # Wf-A5 N3 — checkpoint resumption (per A5_remaining_tasks.json §N3
  # design field + user voice 2026-10-03 "训练时不降低效率且能断点续训").
  # checkpoint_interval = N epochs between persisted resumable checkpoints
  # (final epoch always saves regardless of interval).  resume_from = how
  # to load prior state at the start of each (metal, seed) run:
  #   'auto' — scan ckpt_dir for dmpnn_mtw_{metal}_seed{seed}.pt; cold
  #                   start if not found
  #   'none' — always cold start (ignore any pre-existing checkpoint)
  #   'path' — use --resume-from-path (explicit)
  # Both map to `torch.save` epoch + `trainer flag` — see Wf-A5-N3 closeout
  # in TODO/completed/N3_checkpoint_resume.md + trainer docs at line ~719.
  checkpoint_interval: 50
  resume_from: auto

# ============================================================================
# COMPUTE
# ============================================================================
compute:
  gpu: cuda:0  # RTX PRO 6000 Blackwell
  cpu_workers: 4
  bf16: true

# ============================================================================
# STANDING DIRECTIVES
# ============================================================================
directives:
  kill_then_adapt: true
  time_budget: 10h
  no_enforce_budget: true
  user_ok_required: true
  per_wave_user_ok_required: false  # single-wave protocol (5 seeds serial)

# ============================================================================
# ENTRY POINT — reference existing trainer (do NOT recreate)
# ============================================================================
entry:
  command: /home/hugo/codes/mol-metal/.venv/bin/python molmetal/scripts/train_dmpnn_multitask_wasserstein.py --metals Pt --seeds 0 1 2 3 4 --epochs 50 --batch-size 64 --lr 1e-3 --alpha 0.5 --wasserstein-weight 0.05 --use-l2-guard --device cuda:0 --out-dir {out_dir} --ckpt-dir {ckpt_dir} --no-enforce-budget
  warm_start_checkpoint: "n/a"  # cold-start each seed

# ============================================================================
# CROSS-REFERENCES
# ============================================================================
cross_references:
  - TODO/02_metrics/MECHANISM_METRIC_MAPPING.md  # M17 = Reference loader mechanism
  - TODO/02_metrics/METRICS_TARGETS.md
  - molmetal/scripts/train_dmpnn_multitask_wasserstein.py
