{
  "task": "tmQM bond perception (3D geometry -> molecular graph)",
  "protocol": {
    "ground_truth": "tmQM_X{1,2,3}.BO.gz Wiberg bond orders (same atom indexing as the .xyz.gz geometries)",
    "bo_threshold": 0.3,
    "bond_type": "nearest of single(1.0)/double(2.0)/triple(3.0) by BO",
